// DER de SiPer: datos de personas
// Relaciones: foreignKeys (línea llena) y softForeignKeys (línea de rayas, dashed)
// Pata de gallo del lado "muchos"; el lado "uno" sin marca.
// Línea punteada fina (dotted): referencias transitivas (ej FK a año de una tabla que también referencia a fechas).
// Generar: neato -Tpdf der-personas.dot -o der-personas.pdf   (o -Tsvg / -Tpng)

digraph DER {
  graph [inputscale=0.5714, size="11.7,8.3", splines=true, sep="+4", fontname="Arial"];
  node  [shape=box, style="rounded,filled", fillcolor="#dbe7f5", fontname="Arial", fontsize=14, width=1.35, height=0.95, fixedsize=true];
  edge  [dir=both, arrowtail=crow, arrowhead=none, color="#444444", arrowsize=0.8];

  personas                [pos="5,-3.5!", height=6.20, fontsize=16];

  sexos                   [pos="3,-2!"];
  adjuntos_atributos      [pos="2,-1!", label="adjuntos\natributos"];
  tipos_adjunto_atributos [pos="1,-1!", label="tipos\nadjunto\natributos"];
  adjuntos                [pos="2,-2!"];
  tipos_adjunto           [pos="1,-2!", label="tipos_nadjunto"];
  archivos_borrar         [pos="3,-1!", label="archivos\nborrar"];
  niveles_educativos      [pos="4,-2!", label="niveles\neducativos"];
  jerarquias              [pos="6,-2!", label="jerarquías"];
  trayectoria_laboral     [pos="7,-2!", label="trayectoria\nlaboral"];
  tareas                  [pos="8,-2!"];
  per_capa                [pos="3,-3!"];
  agrupamientos           [pos="6,-3!"];
  tramos                  [pos="7,-3!"];
  funciones               [pos="8,-3!"];
  capa_modalidades        [pos="1,-3!", label="capa_\nmodalidades"];
  capacitaciones          [pos="2,-3!"];
  tipos_telefono          [pos="1,-4!", label="tipos\nteléfono"];
  per_telefonos           [pos="2,-4!", label="per_\nteléfonos"];
  perfiles_sgc            [pos="4,-4!", label="perfiles\nsgc"];
  grados                  [pos="6,-4!"];
  situacion_revista       [pos="8,-4!", label="situación\nrevista"];
  sedes                   [pos="3,-4!"];
  per_domicilios          [pos="3,-5!", label="per_\ndomicilios"];
  tipos_domicilio         [pos="1,-4.99!", label="tipos\ndomicilio"];
  calles                  [pos="2,-5!"];
  barrios_localidades     [pos="3,-6!", label="barrios\nlocalidades"];
  comunas_partidos        [pos="4,-5!", label="comunas\npartidos"];
  barrios                 [pos="1,-6!"];
  provincias              [pos="2,-6!"];
  paises                  [pos="4,-1!", label="países"];
  categorias              [pos="5,-1!", label="categorías"];
  motivos_egreso          [pos="6,-1!", label="motivos\negreso"];
  nivel_grado             [pos="7,-1!"];
  expedientes             [pos="8,-1!"];
  bandas_horarias         [pos="4,-6!", label="bandas\nhorarias"];
  modalidades_trabajo     [pos="5,-6!", label="modalidades\ntrabajo"];
  sectores                [pos="7,-5!"];
  tipos_sec               [pos="8,-5!"];
  tipos_doc               [pos="8,-6!"];
  usuarios                [pos="6,-6!"];
  roles                   [pos="7,-6!"];
  estados_civiles         [pos="7,-4!", label="estados\nciviles"];

  personas -> sectores ;
  personas -> paises ;
  personas -> sexos ;
  personas -> tipos_doc ;
  personas -> bandas_horarias ;
  personas -> perfiles_sgc ;
  personas -> niveles_educativos ;
  personas -> modalidades_trabajo ;
  personas -> motivos_egreso [style=dashed];
  personas -> categorias [style=dashed];
  personas -> agrupamientos [style=dashed];
  personas -> grados [style=dashed];
  personas -> sedes ;
  personas -> estados_civiles ;
  sectores -> sectores;
  sectores -> tipos_sec ;
  per_telefonos -> personas ;
  per_telefonos -> tipos_telefono ;
  per_domicilios -> personas ;
  per_domicilios -> provincias ;
  per_domicilios -> comunas_partidos ;
  per_domicilios -> barrios_localidades ;
  per_domicilios -> calles ;
  per_domicilios -> tipos_domicilio [tailport=c, headport=c];
  comunas_partidos -> provincias ;
  barrios_localidades -> provincias ;
  barrios_localidades -> comunas_partidos ;
  barrios -> provincias ;
  calles -> provincias ;
  per_capa -> personas ;
  per_capa -> capacitaciones ;
  capacitaciones -> capa_modalidades ;
  adjuntos -> tipos_adjunto ;
  adjuntos -> personas ;
  adjuntos -> archivos_borrar [style=dashed, arrowtail=none];
  adjuntos_atributos -> tipos_adjunto_atributos ;
  adjuntos_atributos -> adjuntos ;
  tipos_adjunto_atributos -> tipos_adjunto ;
  usuarios -> personas ;
  usuarios -> roles ;
  trayectoria_laboral -> personas ;
  trayectoria_laboral -> situacion_revista ;
  trayectoria_laboral -> expedientes ;
  trayectoria_laboral -> funciones ;
  trayectoria_laboral -> jerarquias ;
  trayectoria_laboral -> nivel_grado ;
  trayectoria_laboral -> tareas ;
  trayectoria_laboral -> motivos_egreso ;
  trayectoria_laboral -> agrupamientos ;
  trayectoria_laboral -> tramos ;
  trayectoria_laboral -> grados ;
  trayectoria_laboral -> categorias ;
  grados -> tramos ;
}
